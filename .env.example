# ==============================================================================
# PLATFORM ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Do NOT insert real credentials/secrets here.
# ==============================================================================

# Supabase Managed Infrastructure
SUPABASE_URL=http://127.0.0.1:54321   # SERVER ONLY. API derives the JWKS URL from this
                                     # (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsIn... # SERVER ONLY (never expose to client)
# Legacy HS256 secret. The hosted project signs real tokens with an asymmetric
# ES256 key (verified via JWKS from SUPABASE_URL); this only covers pre-migration
# tokens still in TTL and the test suite's own HS256 tokens. NOT the Key ID / kid.
SUPABASE_JWT_SECRET=your-legacy-supabase-jwt-secret # SERVER ONLY
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
# Optional. When set, the API connects as the NOBYPASSRLS `platform_api` role
# instead of `postgres`, so RLS policies are actually enforced (AUD-02). Unset
# = the pre-AUD-02 bypass behaviour. See docs/DEPLOYMENT.md.
# API_DATABASE_URL=postgresql+asyncpg://platform_api:your-platform-api-password@127.0.0.1:54322/postgres

# App Server & Clients configuration
#
# These four are per-surface OVERRIDES. Local development uses them directly.
# Railway injects the deployed surface URLs. When NEXT_PUBLIC_PLATFORM_DOMAIN
# names a custom registrable domain, leave them unset and derive the origins.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_WORKSPACE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Platform Context Configuration
#
# The registrable platform domain (Document 10 SS12, FL-DEC-016). Setting it to a
# real domain does three things at once:
#   - derives https://<domain>, https://app.<domain>, https://admin.<domain>,
#     https://api.<domain> for any surface with no explicit override above;
#   - issues the Supabase session cookie with Domain=.<domain>, so ONE sign-in
#     covers the public site, Workspace and Admin;
#   - serves each Business website from {slug}.<domain>.
#
# It must be a registrable domain. Provider-owned shared domains are rejected:
# browsers cannot scope one session cookie across unrelated customer hosts.
PLATFORM_DOMAIN=localhost
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
# Only needed when the session domain differs from the platform domain.
# NEXT_PUBLIC_SESSION_COOKIE_DOMAIN=locah.in
ENVIRONMENT=local # local | test | staging | production

# AI (server-side only — never expose to Next.js/browser). DeepSeek is the default
# provider for text, website creative + copy, menu/catalogue reading (photos) and
# the picture check; Gemini remains selectable (AI_PROVIDER=gemini) and is the
# only provider for Live voice. With no key, onboarding still works: LOCAH asks its
# own questions and the website is composed deterministically, text-led.
AI_PROVIDER=deepseek # deepseek | gemini | replay (local acceptance only)
DEEPSEEK_API_KEY=your-deepseek-api-key # SERVER ONLY
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=DeepSeek-V4.1-Flash # sent exactly as written; defaults live in website/ai_provider.py
# Optional per-purpose pins: DEEPSEEK_INTERVIEW_MODEL, DEEPSEEK_WEBSITE_MODEL,
# DEEPSEEK_DOCUMENT_MODEL, DEEPSEEK_VISION_MODEL (the picture check)
GEMINI_API_KEY=your-gemini-api-key # SERVER ONLY — Live voice (and AI_PROVIDER=gemini)
# Optional Gemini overrides (defaults live in website/ai_provider.py and interview/voice.py):
# GEMINI_MODEL=
# GEMINI_INTERVIEW_MODEL=
# GEMINI_WEBSITE_MODEL=
# GEMINI_DOCUMENT_MODEL=
# GEMINI_FALLBACK_MODEL=
# Website pictures. stock (default) finds real photographs, looks at each one and
# verifies it fits its slot and loads (website/image_retrieval.py); none = text-led;
# gemini = draw pictures with Gemini (opt-in, paid, never a fallback; the only way to draw a logo).
IMAGE_PROVIDER=stock # stock | gemini | none
# Photo source: auto = Pexels when PEXELS_API_KEY is set, otherwise Wikimedia Commons (no key,
# freely licensed files only: public domain, CC0, CC BY, CC BY-SA; credit + licence are stored
# with each picture). pexels | commons force one.
IMAGE_SEARCH_PROVIDER=auto
PEXELS_API_KEY= # SERVER ONLY — optional; leave empty to use Wikimedia Commons
# IMAGE_MAX_ROUNDS=3 # search/check rounds per picture before the slot stays empty (1-6)
# IMAGE_CANDIDATES_PER_ROUND=4 # pictures the vision check looks at together (1-8)
# IMAGE_ACCEPT_SCORE=70 # 0-100 fit a picture needs, on top of the checker's own accept (1-100)
# IMAGE_VISION_INPUT=thumbnail # thumbnail (default): LOCAH fetches a small preview into memory, never stored |
#   url: send the link, the model fetches it | auto: link first, preview if the provider refuses links
# IMAGE_ALLOWED_HOSTS=images.pexels.com,upload.wikimedia.org,thumb.wikimedia.org # hosts a picture URL may point at (https only)
# IMAGE_ALLOWED_LICENCES=public domain,cc0,pd,cc by # Commons licences accepted (prefix match; -NC/-ND are always refused)
# IMAGE_SLOT_TIMEOUT_SECONDS=75
# GEMINI_IMAGE_MODEL= # only with IMAGE_PROVIDER=gemini
VOICE_PROVIDER=gemini # gemini | replay
# GEMINI_LIVE_MODEL=
# GEMINI_VOICE=
# Development without spending AI credit (see README.md):
#   LOCAH_TEST_NO_EXTERNAL_AI=1 refuses every paid AI call before it leaves the process;
#   AI_PROVIDER=replay + LOCAH_AI_REPLAY_FILE=<json> and
#   VOICE_PROVIDER=replay + LOCAH_VOICE_REPLAY_FILE=<json> (replay voice needs the kill switch on).
# LOCAH_TEST_NO_EXTERNAL_AI=1

# Extra CORS origins, comma-separated. Never use * with credentials.
# The platform's own origins (and every {slug}.<PLATFORM_DOMAIN> Business
# website) are derived from PLATFORM_DOMAIN and do not need listing here. Use
# this only for origins outside it, such as Railway's generated service domains.
# CORS_ALLOWED_ORIGINS=https://locah-web-production.up.railway.app,https://locah-workspace-production.up.railway.app
# Behind Railway's proxy, trust the last X-Forwarded-For hop:
# RATE_LIMIT_TRUST_XFF=1

# Payment provider (Razorpay)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-key-secret # SERVER ONLY — platform account, not merchant keys
# Basis points withheld as the LOCAH platform fee on Route transfers (0–10000). 0 until commercially set.
RAZORPAY_PLATFORM_FEE_BPS=0
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-hmac-secret # SERVER ONLY (Stage 9 webhook verification)
WEBSITE_PREVIEW_SECRET=your-website-preview-hmac-secret # SERVER ONLY (Stage 2 preview tokens)

# Worker Settings
WORKER_POLL_INTERVAL_SECONDS=2
# WORKER_LAG_THRESHOLD_SECONDS=300 # /health/worker reports 503 above this outbox lag

# Encrypts each business's provider credentials and tokens at rest (Fernet key) — SERVER ONLY
# PAYMENT_CREDENTIAL_KEY=

# Website cache refresh: the worker calls the web app when something a site shows changes.
# Worker: WEB_REVALIDATE_URL=https://<web host>/api/revalidate and WEB_REVALIDATE_SECRET;
# web app: REVALIDATE_SECRET with the same value. Unset = sites refresh within a minute.
# WEB_REVALIDATE_URL=
# WEB_REVALIDATE_SECRET=
# REVALIDATE_SECRET=

# AI Employee Sandbox (a simulation; writes and sends nothing). On unless set to 0.
# AI_SANDBOX_ENABLED=1

# WhatsApp (Meta) — only once activated; until both secrets are set the webhooks answer 404
# META_APP_ID=
# META_APP_SECRET= # SERVER ONLY
# META_GRAPH_VERSION=
# META_ES_CONFIG_ID=
# META_ADVANCED_ACCESS=0
# WHATSAPP_VERIFY_TOKEN= # SERVER ONLY
