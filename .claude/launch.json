{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--env-file",
        ".env",
        "uvicorn",
        "platform_api.main:app",
        "--app-dir",
        "apps/api/src",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "worker",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--env-file",
        ".env",
        "python",
        "-m",
        "platform_worker.main"
      ],
      "port": 8099
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "accept-auth",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/acceptance/stack/mock-auth.mjs"
      ],
      "port": 54321
    },
    {
      "name": "accept-api",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": [
        "tools/acceptance/stack/api.sh"
      ],
      "port": 8010
    },
    {
      "name": "accept-workspace",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": [
        "tools/acceptance/stack/workspace.sh"
      ],
      "port": 3101
    },
    {
      "name": "accept-web",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": [
        "tools/acceptance/stack/web.sh"
      ],
      "port": 3100
    },
    {
      "name": "accept-api-posix",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "tools/acceptance/stack/api.sh"
      ],
      "port": 8010
    },
    {
      "name": "accept-workspace-posix",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "tools/acceptance/stack/workspace.sh"
      ],
      "port": 3101
    },
    {
      "name": "accept-web-posix",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "tools/acceptance/stack/web.sh"
      ],
      "port": 3100
    },
    {
      "name": "site-lab",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": [
        "tools/site-lab/serve.sh"
      ],
      "port": 3005
    }
  ]
}
