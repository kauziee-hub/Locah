# SERVER-ONLY secrets for the API and worker. Copy to server.env ON THE VM and fill
# it in there (chmod 600). Never commit it, never paste it into chat or a ticket.
# Names match the repository's .env.example; see it for what each one does.

SUPABASE_URL=https://pmwyaqmwxfbnfulqbqmk.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# The Supabase session pooler or direct connection, as postgresql+asyncpg://...
DATABASE_URL=
# API_DATABASE_URL=   # the NOBYPASSRLS platform_api role (docs/DEPLOYMENT.md)

# the same value as in public.env
REVALIDATE_SECRET=
WEBSITE_PREVIEW_SECRET=
PAYMENT_WEBHOOK_SECRET=

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

IMAGE_SEARCH_PROVIDER=unsplash
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
PIXABAY_API_KEY=
IMAGE_FALLBACK=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shadow quality gate on every build; logged, never blocks.
WEBSITE_CERTIFICATION=record
