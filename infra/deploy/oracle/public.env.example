# Browser-visible configuration for the Oracle VM. Copy to public.env ON THE VM.
# Nothing here is a secret: every value ends up in the browser or in public DNS.
# (The Supabase anon key is public by design; Row Level Security protects data.)

PLATFORM_DOMAIN=locah.store
NEXT_PUBLIC_PLATFORM_DOMAIN=locah.store
NEXT_PUBLIC_SESSION_COOKIE_DOMAIN=locah.store
ENVIRONMENT=staging

NEXT_PUBLIC_API_URL=https://api.locah.store
NEXT_PUBLIC_WEB_URL=https://locah.store
NEXT_PUBLIC_WORKSPACE_URL=https://app.locah.store
NEXT_PUBLIC_SUPABASE_URL=https://pmwyaqmwxfbnfulqbqmk.supabase.co
# from Supabase > Project Settings > API (the anon/public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Let's Encrypt account e-mail for certificate notices (Caddy).
ACME_EMAIL=
# A long random string shared by web and the API (openssl rand -hex 32). Also in server.env.
REVALIDATE_SECRET=
